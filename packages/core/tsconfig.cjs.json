{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist/cjs",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // `src/apps` — the app-generation contract door — is ESM-only and stays out
  // of the CommonJS arm: it reads `import.meta.url` (illegal under
  // `module: CommonJS`) and resolves the engine's WebAssembly through the
  // `#engine/wasm` condition, which `moduleResolution: Node10` cannot see. The
  // `.` and `./conformance` entries are the CJS surface; `./apps` has no
  // `require` leg, exactly as `@vendoai/apps/contract` had none.
  "exclude": ["src/**/*.test.ts", "src/apps"]
}
