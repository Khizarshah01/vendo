{
  // The test estate. `tsconfig.json` excludes it so `dist` stays free of test
  // scaffolding, which also meant nothing ever typechecked it. Its own program,
  // never built — same shape as `apps`, `store`, `actions` and
  // `vendo-telemetry`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Several tests read `box/turn-routes.mjs` — the zero-dependency control-port
    // runtime, published as source and carrying no `types`. Reading the JS gives
    // them the real inferred signature instead of an ambient re-declaration that
    // could drift from it. There is no `.js` under `src`, so this widens nothing
    // else.
    "allowJs": true
  },
  "include": ["src", "box", "tests", "vitest.setup.ts"]
}
